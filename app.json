{
  "expo": {
    "name": "Kokani Engineers & Professional Association",
    "slug": "kea-mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/kea-logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-full.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow KEA to use Face ID for secure biometric authentication."
      }
    },
    "scheme": "kea-mobile-app",
    "android": {
      "package": "com.kea.mobileapp",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/kea-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/kea-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-local-authentication"
    ]
  }
}
